diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,10 +515,10 @@
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (0x9d400000 + 3088 * 5760)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #5760
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -692,6 +692,13 @@
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	/* G7's 36 MiB splash reservation spans two 32 MiB blocks.
+	 * x10 below is the second aligned block, not the unaligned FB base. */
+	MOV64	x10, 0x9e000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	add		x12, x12, #1
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
 #endif
 
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,11 +11,11 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9d400000;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_WIDTH 1440u
+#define EARLY_HEIGHT 3120u
+#define EARLY_STRIDE (5760u / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -99,7 +99,7 @@
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
-	sweet_early_string("SWEET EARLY ");
+	sweet_early_string("G7 EARLY ");
 	if (stage >= 10) {
 		sweet_early_putc((char)('0' + stage / 10));
 	}
@@ -116,7 +116,7 @@
 		return;
 	}
 	early_panicking = 1;
-	sweet_early_string("\nSWEET EARLY PANIC: ");
+	sweet_early_string("\nG7 EARLY PANIC: ");
 	va_list copy;
 	va_copy(copy, *args);
 	_doprnt(fmt, &copy, sweet_early_putc, 16);
